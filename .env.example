# Supabase project settings (Project Settings → API). Copy to .env.local for `npm run dev`.
# The anon key is safe in the browser: row-level security decides what each user can see.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only for scripts/import-xlsx.ts. Never put the service-role key in a VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
